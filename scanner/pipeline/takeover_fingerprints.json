  "services": [
    {
      "id": "azure_app_service",
      "name": "Microsoft Azure App Service",
      "status": "vulnerable",
      "cname": ["azurewebsites.net"],
      "nxdomain_required": true,
      "fingerprints": [],
      "source": ["ciotx", "msdocs"],
      "checked": "2026-10-06",
      "note": "App names are global and first-come; NXDOMAIN on the app name means it is free to create. An asuid.<name> TXT record (custom-domain verification) stops another subscription from binding the org's name even then, so the stage looks that record up before reporting."
    },
    {
      "id": "azure_cloud_services",
      "name": "Microsoft Azure Cloud Services / public IP DNS label",
      "status": "edge_case",
      "cname": ["cloudapp.net", "cloudapp.azure.com"],
      "nxdomain_required": true,
      "fingerprints": [],
      "source": ["ciotx", "msdocs"],
      "checked": "2026-10-06",
      "note": "A deleted classic cloudapp.net name is reserved for the owning tenant for a while before any subscription can claim it; cloudapp.azure.com labels are per region. NXDOMAIN alone does not say which phase the name is in."
    },
