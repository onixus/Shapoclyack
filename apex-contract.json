    "production_trusts_unsigned_role_header": false,
    "owning_service_authorizes_mutations": true
  },
  "resources": [
    {
      "kind": "asset",
      "local_id_field": "asset_id",
      "urn_prefix": "urn:apex:asset:shapoclyack:"
    },
    {
      "kind": "finding",
      "local_id_field": "finding_id",
      "urn_prefix": "urn:apex:finding:shapoclyack:"
    },
    {
      "kind": "evidence",
      "local_id_field": "evidence_id",
      "urn_prefix": "urn:apex:evidence:shapoclyack:"
    }
  ],
  "integration": {
    "consumes": [
      "pulse.scan-observation",
      "lariska.inventory-snapshot"
    ],
    "produces": [
      "asset",
      "finding",
      "evidence",
      "remediation-state"
    ]
  },
  "observability": {
    "w3c_trace_context": true,
    "otel_resource_attribute": "apex.system",
    "apex_system_value": "shapoclyack"
  },
  "supply_chain": {
    "sbom_required": true,
