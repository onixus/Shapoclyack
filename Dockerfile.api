# Shapoclyack thin API + Web UI v2 image (no scanner tools).
# Every stage is pinned by index digest, not only the final one (#313); see
# the go-tools stage in Dockerfile.
FROM node:26-bookworm-slim@sha256:662933cf47f013bc8e4beb31a6116448427a82057ba7c42c97e4c5ba766504c2 AS web-build
WORKDIR /web
COPY web-next/package.json web-next/package-lock.json ./
RUN npm ci
COPY web-next/ ./
RUN npm run build

# Shared source/checksum pin and install allowlist for the SSH deployment client.
# Build against the runtime's Debian ABI; compilers and headers stay here.
FROM python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016 AS openssh-client-build
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl pkg-config libssl-dev zlib1g-dev \
      libfido2-dev libkrb5-dev libedit-dev && rm -rf /var/lib/apt/lists/*
COPY scripts/build-openssh-client.sh /tmp/build-openssh-client.sh
RUN sh /tmp/build-openssh-client.sh

FROM python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016

LABEL org.opencontainers.image.source="https://github.com/onixus/Shapoclyack" \
      org.opencontainers.image.title="shapoclyack-api" \
      org.opencontainers.image.description="Shapoclyack API + Web UI v2 image"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OCTO_WEB_DIST=/app/web/dist \
    OCTO_API_HOST=0.0.0.0 \
    OCTO_API_PORT=8080

WORKDIR /app
# The SSH deployer uses the fixed client built above. Its runtime libraries
# also preserve GSSAPI/FIDO/PKCS11 and interactive sftp support.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends fonts-dejavu-core libssl3t64 zlib1g libfido2-1 libgssapi-krb5-2 libedit2; \
    # Security updates the pinned base digest does not carry yet: Debian has
    # published them, python:3.12-slim has not been rebuilt on top. Upgrade
    # only the named packages, and assert the version so a no-op upgrade fails
    # here rather than at the Trivy gate. Drop a line once a base bump covers it.
    apt-get install -y --no-install-recommends --only-upgrade libpcre2-8-0; \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.46-1~deb13u3'; \
    rm -rf /var/lib/apt/lists/*
# Copy only client binaries, helpers, config and provenance; no vulnerable
# distro copy, SSH server, host keys or privileged signing helper ships.
COPY --from=openssh-client-build /out/ /
RUN set -eux; \
    ! dpkg-query -W -f='${Status}' openssh-client 2>/dev/null | grep -q 'install ok installed'; \
    ssh -V 2>&1 | grep -F 'OpenSSH_10.6p1'; \
    for program in ssh scp sftp ssh-add ssh-agent ssh-keygen ssh-keyscan; do \
      test -x "/usr/bin/$program"; \
      libraries="$(ldd "/usr/bin/$program")"; \
      case "$libraries" in *'not found'*) echo "$libraries" >&2; exit 1;; esac; \
    done; \
    for helper in ssh-pkcs11-helper ssh-sk-helper; do \
      test -x "/usr/lib/openssh/$helper"; \
      libraries="$(ldd "/usr/lib/openssh/$helper")"; \
      case "$libraries" in *'not found'*) echo "$libraries" >&2; exit 1;; esac; \
    done

# Installed from the hash-pinned locks, not from requirements-api.txt (#313);
# see the same step in Dockerfile for why and requirements-pip.txt for the pip.
# Package installers are build-only; remove pip and its bundled bootstrap wheel
# after the locked install so vendored tooling does not ship in runtime images.
COPY requirements-pip.lock requirements-api.lock /app/
RUN set -eux; \
    pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements-pip.lock; \
    pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements-api.lock; \
    python -m pip uninstall --yes pip; \
    python -c "import ensurepip, pathlib, shutil; shutil.rmtree(pathlib.Path(ensurepip.__file__).parent)"; \
    python -c "import importlib.util; assert importlib.util.find_spec('pip') is None; assert importlib.util.find_spec('ensurepip') is None"

# The images redistribute scanner/data, and the EPSS overlay in it is CC BY 4.0.
# The attribution has to travel with the bytes, not stay in the repository.
COPY LICENSE NOTICE /app/
COPY scanner /app/scanner
# Pristine copy of the committed enrichment seed. scripts/fetch-enrichment.sh
# uses this as its floor: the runtime target is /app/scanner/data itself, so
# when a shared enrichment volume is mounted there it shadows the baked seed
# and the floor would have nothing to copy from.
COPY scanner/data /opt/shapoclyack/seed-data
COPY api /app/api
# Shared standard-library contracts also ship in the signed sensor tree. The
# API needs only this leaf package, not the sensor worker or its dependencies.
COPY agent/__init__.py /app/agent/__init__.py
COPY agent/runtime /app/agent/runtime
COPY scripts /app/scripts
COPY --from=web-build /web/out /app/web/dist

# Bake real EPSS/KEV data into the image (used by api/services/risk_scoring.py's
# contextual scoring) so a fresh deployment isn't limited to what the repo
# committed. This image has no scanner tools, so GeoIP/CVSS4 (scanner-side
# enrichment) aren't fetched here — the committed baselines are copied in above
# and reported as such.
#
# A feed being unreachable stays non-fatal, but it no longer disappears: the
# manifest records which datasets this build actually refreshed, and the image
# serves it back through GET /api/system (#246). ENRICHMENT_STRICT=1 — set by
# the release pipeline, see Jenkinsfile.publish — additionally refuses to build
# an image whose required data is missing or is a stub, which is the case that
# would have the risk model scoring blind.
ARG ENRICHMENT_STRICT=0
RUN set -eu; \
    python3 scripts/nvd_snapshot.py verify /opt/shapoclyack/seed-data/cvss4/cvss4.json; \
    refreshed=""; failed=""; \
    if bash scripts/fetch-epss-db.sh; then refreshed="$refreshed,epss"; else failed="$failed,epss"; fi; \
    if bash scripts/fetch-kev-db.sh; then refreshed="$refreshed,kev"; else failed="$failed,kev"; fi; \
    status=0; \
    python3 scripts/enrichment_manifest.py --dir /app/scanner/data \
      --refreshed "$refreshed" --failed "$failed" || status=$?; \
    if [ "$status" -ge 2 ]; then \
      if [ "${ENRICHMENT_STRICT}" = "1" ]; then \
        echo "ENRICHMENT_STRICT=1: refusing to publish an image whose enrichment data is missing or stubbed" >&2; \
        exit 1; \
      fi; \
      echo "warning: enrichment data is missing or stubbed; continuing (ENRICHMENT_STRICT=0)" >&2; \
    fi

RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin octo && \
    mkdir -p /app/scanner/output /app/scanner/state && \
    chown -R octo:octo /app
USER octo

EXPOSE 8080
# CIS Docker Benchmark 4.6/5.27: in-image liveness check for docker/compose
# runs; under k8s the probes in api-deployment.yaml remain authoritative.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["python", "-c", "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/api/health' % os.environ.get('OCTO_API_PORT', '8080'), timeout=4)"]
CMD ["python", "-m", "api"]
