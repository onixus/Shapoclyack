          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "title": "SLA breached by tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
