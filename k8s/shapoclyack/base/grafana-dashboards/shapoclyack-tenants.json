        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (tenant, status) (octo_tenant_scans_finished_24h{job=~\"$job\",tenant=~\"$tenant\"})",
          "legendFormat": "{{tenant}} {{status}}",
          "refId": "A"
        }
