        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tenant) (max by (tenant, status) (octo_tenant_scans_finished_24h{job=~\"$job\",tenant=~\"$tenant\",status=\"failed\"})) / sum by (tenant) (max by (tenant, status) (octo_tenant_scans_finished_24h{job=~\"$job\",tenant=~\"$tenant\"}))",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "title": "Failed share of scans by tenant",
      "type": "timeseries",
      "gridPos": {
