{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-tenant open findings, SLA breaches and scans, from the opt-in capped tenant series (OCTO_METRICS_TENANT_TOP_N, #334). Empty while that is off.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "shapoclyack"
      ],
      "targetBlank": false,
      "title": "Shapoclyack",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "options": {
        "mode": "markdown",
        "content": "Per-tenant product figures, **opt-in**: nothing appears here until the API runs with `OCTO_METRICS_TENANT_TOP_N` > 0 (it refuses to start under `OCTO_ENV=prod` without `OCTO_METRICS_TOKEN`, because these series name tenants). The top N tenants by open findings plus scans in the last 24 h keep their id; every other tenant is summed into `_other`, so the `tenant` label is bounded at N + 1 values (N ≤ 50). Which tenants are in the top N can change between snapshots. Counts are read from the database every minute and are the same on every replica, hence `max()`. See docs/observability.md."
      },
      "title": "About this dashboard",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "panels": [],
      "title": "Findings",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Findings in any state but CLOSED, all severities.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tenant) (max by (tenant, severity) (octo_tenant_open_findings{job=~\"$job\",tenant=~\"$tenant\"}))",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "title": "Open findings by tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 3
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "The findings an SLA is usually shortest for.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tenant) (max by (tenant, severity) (octo_tenant_open_findings{job=~\"$job\",tenant=~\"$tenant\",severity=~\"critical|high\"}))",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "title": "Open critical and high by tenant",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 4
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
