<clickhouse>
  <users>
    <default>
      <!-- from_env reads CLICKHOUSE_PASSWORD, which statefulset.yaml wires
           to the shapoclyack-clickhouse Secret (secretGenerator in
           base/kustomization.yaml, same mechanism as Postgres). The
           entrypoint uses that same variable for the first-boot init.sql
           client, so the two can never drift apart.

           Do not put the password literally here: this file is a
           ConfigMap, readable by anything that can GET configmaps in the
           namespace.

           replace="replace" is required, not decorative: the image ships
           /etc/clickhouse-server/users.xml with <password></password>, and
           merging from_env onto an element that already has a value is a
           hard startup error ("has value and does not have 'replace'
           attribute"). Same for <networks> below, which would otherwise
           keep the image's ::/0 entry alongside ours. -->
      <password from_env="CLICKHOUSE_PASSWORD" replace="replace"/>
      <!-- Was ::/0 — every address on earth, which with a NodePort or a
           LoadBalancer in front of 8123 is exactly what it says. Private
           ranges are the widest set that is still correct on any CNI;
           narrow this to the actual pod CIDR in an overlay if you know it.
           The real boundary is the password above plus
           base/networkpolicy-datastores.yaml, since pod IPs live in these
           ranges too. -->
      <networks replace="replace">
        <ip>10.0.0.0/8</ip>
        <ip>172.16.0.0/12</ip>
        <ip>192.168.0.0/16</ip>
        <ip>127.0.0.1</ip>
        <ip>::1</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
      <!-- 0, not 1: the API reads, inserts, and deletes one tenant's rows
           when a tenant is purged (ALTER DELETE, #325) — none of which
           needs user management. With access_management on, anyone
           reaching 8123 with this account could CREATE USER and keep access
           across a password rotation. -->
      <access_management>0</access_management>
    </default>
    <!-- The backup CronJob's account (#333), so that pod does not hold the
         API's: BACKUP of this database, S3 (the upload and the manifest's
         s3() reads, which also need temporary tables) and its own
         progress in system.backups. Measured on 24.8: it cannot SELECT the
         tables, DROP, INSERT, RESTORE, call url(), run SYSTEM or manage
         users. S3 ON *.* is not scoped to a bucket in 24.8 — the bucket
         key's own policy is that boundary.

         The password is from_env like default's, and the variable must
         never be unset: an unset from_env is an EMPTY password on 24.8
         (one warning in the log). statefulset.yaml therefore reads it from
         a Secret base always generates, without optional: true. -->
    <shapoclyack_backup>
      <password from_env="CLICKHOUSE_BACKUP_PASSWORD"/>
      <networks>
        <ip>10.0.0.0/8</ip>
        <ip>172.16.0.0/12</ip>
        <ip>192.168.0.0/16</ip>
        <ip>127.0.0.1</ip>
        <ip>::1</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
      <access_management>0</access_management>
      <grants>
        <query>GRANT BACKUP ON shapoclyack.*</query>
        <query>GRANT S3 ON *.*</query>
        <query>GRANT CREATE TEMPORARY TABLE ON *.*</query>
        <query>GRANT SELECT ON system.backups</query>
      </grants>
    </shapoclyack_backup>
  </users>
  <profiles>
    <default>
      <max_memory_usage>4000000000</max_memory_usage>
      <use_uncompressed_cache>0</use_uncompressed_cache>
      <load_balancing>in_order</load_balancing>
    </default>
  </profiles>
  <quotas>
    <default>
      <interval>
        <duration>3600</duration>
        <queries>0</queries>
        <errors>0</errors>
        <result_rows>0</result_rows>
        <read_rows>0</read_rows>
        <execution_time>0</execution_time>
      </interval>
    </default>
  </quotas>
</clickhouse>
